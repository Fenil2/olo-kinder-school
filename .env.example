# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Neon Postgres -----------------------------------------------------------
# Both come from the Neon console (Dashboard → Connection Details).
# Pooled (PgBouncer). The app uses this one at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection. Migrations use this one — DDL cannot run over PgBouncer.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin dashboard (/admin) ------------------------------------------------
# The password for the dashboard. Pick your own.
ADMIN_PASSWORD="Admin@1234"
# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
ADMIN_SESSION_SECRET="64-hex-characters"
